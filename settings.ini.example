# OneLap到多平台数据同步工具配置文件（示例）

[app]
name = OneLap到多平台数据同步工具
version = 1.2.16
log_level = INFO
headless_mode = false
debug_mode = false

[onelap]
username = 13800138000
password = your_password_here

[xoss]
username = 13800138000
password = your_password_here
# 作为“目标平台”时是否上传到行者（data_source = xoss 时行者是数据源，此项不生效）
enable_sync = false
# 行者 start_time 是毫秒级 UTC 时间戳，默认 +8 小时换算为北京时间；若时间有偏差可微调
time_offset_hours = 8
# 导出运动文件时优先 Fit（含心率/功率/踏频等完整数据），失败时自动回退 GPX
prefer_fit = true
# 上传到 OneLap 后是否再做一次“入库时间校验”（两侧时间口径不一致时可能误判，默认关闭）
verify_onelap_upload = false
# 试运行：只登录行者并下载记录，不向任何平台上传（首次验证强烈建议先开一次）
dry_run = false
# 登录方式：auto=先免浏览器登录(账号密码+RSA)，失败自动回退浏览器（推荐）
#          browser=只用浏览器登录（与旧行为一致）
#          http=只用免浏览器登录（适合无图形环境）
# 注意：免浏览器登录要求 username 填手机号
login_mode = auto

[giant]
username = 13800138000
password = your_password_here
enable_sync = false

[igpsport]
username = 13800138000
password = your_password_here
enable_sync = false

[garmin]
username = 13800138000
password = your_password_here
enable_sync = false
# Garmin 每批最多上传文件数；0 表示使用 [sync] max_files_per_batch
max_upload_files = 0

[strava]
enable_sync = false
client_id =
client_secret =
access_token =
refresh_token =
expires_at = 0
redirect_port = 8765
athlete_id =
athlete_name =
# OneLap FIT 使用 GCJ-02 坐标系，Strava 需要 WGS84；启用后上传前自动转换
gcj02_to_wgs84 = true

[sync]
# 数据源：onelap = 顽鹿为源（原逻辑，OneLap → 行者/捷安特/iGPSport/Garmin/Strava）
#        xoss    = 行者为源（行者 → OneLap / iGPSport）
data_source = onelap
storage_dir = ./downloads
supported_formats = .fit,.gpx,.tcx
max_file_size_mb = 50
max_files_per_batch = 5
# OneLap 是否强制全量下载 (true=全量下载并忽略各平台基准, false=按基准增量下载)
onelap_full_sync = false

[igpsport_to_onelap]
enable = false
mode = auto
strategy = time_based

